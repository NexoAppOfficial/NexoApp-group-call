<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>NexoApp Group Call</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        #root { width: 100vw; height: 100vh; }
    </style>
</head>
<body>
    <div id="root"></div>

    <script src="https://unpkg.com/@zegocloud/zego-uikit-prebuilt/zego-uikit-prebuilt.js"></script>
    <script>
        const appID = 233961104;
        const serverSecret = "8475a53e8eded3d1daaac9fe7baa7222";

        // Auto generate roomID
        const roomID = "group_" + Math.floor(Math.random() * 1000000);
        const userID = Math.floor(Math.random() * 10000) + "";
        const userName = "User_" + userID;

        // Check media type from URL (voice or video)
        const urlParams = new URLSearchParams(window.location.search);
        const media = urlParams.get('media') || "voice";

        const kitToken = ZegoUIKitPrebuilt.generateKitTokenForTest(
            appID,
            serverSecret,
            roomID,
            userID,
            userName
        );

        const zp = ZegoUIKitPrebuilt.create(kitToken);
        zp.joinRoom({
            container: document.querySelector("#root"),
            sharedLinks: [{
                name: 'Join Group Call',
                url: window.location.protocol + '//' + window.location.host + window.location.pathname + 
                     '?roomID=' + roomID + '&media=' + media,
            }],
            scenario: {
                mode: ZegoUIKitPrebuilt.GroupCall,
            },
            turnOnCameraWhenJoining: media === "video",
            turnOnMicrophoneWhenJoining: true,
            showMyCameraToggleButton: true,
            showMyMicrophoneToggleButton: true,
            showAudioVideoSettingsButton: true,
            showScreenSharingButton: true,
            showTextChat: true,
            showUserList: true,
            showPreJoinView: false,
        });
    </script>
</body>
</html>